# Quality gate configuration for graph-provider.
#
# A new repository with no legacy: every tool that is present is green, so those
# gates start at enforce rather than easing in. The four that are not enforcing
# are not enforcing because the runner cannot actually check them here — a gate
# that can never be green teaches people to ignore red, which is the one failure
# mode this file exists to prevent.

STACK=go

# --- gates -------------------------------------------------------------------

# gofmt -l over the tree. Green, and the formatter is in the toolchain.
format=enforce

# staticcheck 2025.1.1 is on PATH but was built with go1.25.2 and refuses a
# module requiring go1.26.7 - it reports a compile error for the toolchain, not
# a finding about this code. Pinned to go vet until a staticcheck built with
# go1.26 is available; the date is the reminder to look again.
lint=enforce
lint_cmd="go vet ./..."
lint_until=2026-10-09
lint_why="staticcheck 2025.1.1 cannot analyse a go1.26 module; go vet is green and is the stand-in"

# `go build ./...`. Redundant with build on this stack; kept enforcing because
# the catalog entry is about the strictest type check the stack has, and for Go
# that is the compiler.
typecheck=enforce

build=enforce
test=enforce

# gitleaks 8.30.1, installed. Scans uncommitted changes to tracked files and
# untracked files - which, before the history starts, is everything.
secrets=enforce

# govulncheck, wrapped so the gate means what the catalog says it means: a
# finding with an available fix blocks, a finding nobody can act on is reported.
# The raw command exits non-zero for both, which would leave a permanent red.
vulns=enforce
vulns_cmd="bash scripts/vulns.sh"

# The runner has no Go implementation, so scripts/deps-license.sh is it: every
# module in the build classified against an allow list of permissive licence
# texts, failing closed on anything it has not been taught.
deps_license=enforce
deps_license_cmd="bash scripts/deps-license.sh"

# Coverage of the lines a branch changed against the repository average, from
# the Go coverage profile and git diff. With no history yet there is no changed
# set, and the script says so and passes - a fact about the repository, not a
# hole in the check.
coverage_delta=enforce
coverage_delta_cmd="bash scripts/coverage-delta.sh"

# --- path intensity ----------------------------------------------------------
# Persistence in the sense this catalog means it: the graph store is the only
# writer to somebody else's data, and the permission writes decide who may see
# a company's devices. A change there gets the strictest treatment whatever the
# modes above say.
CRITICAL_PATHS='pkg/graphs/* pkg/keycloak/* pkg/reconcile/*'

# Documentation only. One file outside this list and everything runs.
RELAXED_PATHS='*.md LICENSE'
