#
# Copy to .env and fill in. That file is gitignored; this one is not, so never
# put a real secret here. launch.json reads .env.
#
# The addresses below are the in-cluster names, reachable through netbird. They
# are service.namespace.svc.cluster.local - taken from the platform's own
# deployment definitions, not guessed. They must NOT point at the API gateway:
# the internal admin token this service authenticates with is rejected there.

# --- reachable through netbird, no credentials needed -------------------------
DEVICE_REPOSITORY_URL=http://api.device-repository.svc.cluster.local:8080
PERMISSIONS_V2_URL=http://permv2.permissions.svc.cluster.local:8080
TIMESCALE_WRAPPER_URL=http://timescale-wrapper.timescale.svc.cluster.local:8080

# Not needed for a dry run - it starts no consumers. Set it before running the
# service proper.
KAFKA_URL=kafka.kafka.svc.cluster.local:9092

# --- Keycloak: the one thing that needs credentials --------------------------
# The service reads the group tree through the admin API. The internal admin
# token does not reach Keycloak, so this needs a real confidential client.
#
# YOU MUST CREATE THIS. In the realm below:
#   1. Clients -> Create client
#        Client ID: graph-provider
#        Client authentication: On          (makes it confidential)
#        Authentication flow: Service accounts roles ON, everything else OFF
#   2. The new client -> Credentials -> copy the client secret into
#      KEYCLOAK_CLIENT_SECRET
#   3. The new client -> Service accounts roles -> Assign role
#        filter by clients -> "master-realm" -> view-users AND query-groups
#
#      view-users, not view-groups. view-groups is a role of the "account"
#      client - a user seeing their own groups - and does not exist on
#      <realm>-realm at all. In Keycloak's admin model groups sit under the
#      users scope, so view-users is what opens the group tree.
#
#      BOTH roles. query-groups alone does not fail loudly: Keycloak filters
#      the group listing by what the caller may view, so the account gets an
#      empty array and HTTP 200 - indistinguishable from a realm with no
#      groups. Observed here: /groups answered [] while /groups/count answered
#      {"count":2}. The service now detects exactly that and refuses instead
#      of believing it.
#      Verified against this realm.
#
#      The client name is the trap. A realm is administered by a client named
#      "<realm>-realm", so for the realm "master" it is "master-realm". The
#      picker also offers "realm-management" and "account" and every other
#      realm's "<realm>-realm" - roles from any of those grant nothing here and
#      the service gets a 403 on /admin/realms/master/groups, with a valid
#      token. Those two roles are all it needs; do not grant realm-admin.
#
# The /auth prefix is NOT optional here. This Keycloak serves under it -
# verified: /auth/realms/master/.well-known/openid-configuration answers 200,
# the same path without /auth answers 404. The service appends
# /realms/... and /admin/realms/... to whatever is configured, so the prefix
# belongs in this value.
KEYCLOAK_URL=http://keycloak.keycloak.svc.cluster.local:8080/auth
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=graph-provider
KEYCLOAK_CLIENT_SECRET=

# --- the owner of every graph this service creates ---------------------------
# Its only user-level administrator. The service warns if this is not the
# subject of its own token; that warning is a hint, not a refusal.
#
# The internal admin token's subject, which is what the service authenticates
# with, is:
SERVICE_USER_ID=dd69ea0d-f553-4336-80f3-7f4567f85c7b

# --- narrow the blast radius while trying this out ---------------------------
# Comma-separated path prefixes. An absent GROUP_INCLUDE means every group in
# the realm gets a graph - fine for a dry run, and worth thinking about before
# the first real write.
#
# LEAVE THESE COMMENTED OUT rather than setting them empty. An env file sets a
# variable to the empty string, and the config loader parses an empty string
# rather than treating it as unset: GROUP_INCLUDE= fails with "unexpected end
# of JSON input" and ENABLED= with a ParseBool error. Verified, and pinned by
# TestAnEmptyEnvValueIsNotTheSameAsUnset.
# GROUP_INCLUDE=/customers
# GROUP_EXCLUDE=/internal,/platform

# --- readable output while poking at it --------------------------------------
LOGGER_HANDLER=text
LOGGER_LEVEL=info

# The kill switch. The launch configurations set this explicitly, so the value
# here is only used when running the binary by hand.
ENABLED=false
